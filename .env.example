# Copy to .env and fill in. Never commit .env.

# Password of the bundled Postgres. Generate one, for example:  openssl rand -hex 24
# Use letters and digits only (hex is fine): it is placed inside DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@postgres:5432/postgres

# Apps get https://<service>-<project>.<APPS_DOMAIN>. Point a wildcard DNS record (*.<APPS_DOMAIN>) at this server.
APPS_DOMAIN=apps.example.com

# Contact address for Let's Encrypt certificate notices.
ACME_EMAIL=

# Hostname of the web dashboard, https://<PANEL_DOMAIN> (plus :<TRAEFIK_HTTPS_PORT> in the alternate-port mode).
# It must be a name that reaches this server: put it under APPS_DOMAIN so the wildcard DNS record covers it.
# With the wildcard certificate (docker-compose.dns-tls.yml, see below) it MUST be exactly one label under
# APPS_DOMAIN, such as panel.<APPS_DOMAIN>: the certificate covers no other name, and the worker refuses to start
# otherwise. For this server that is  PANEL_DOMAIN=panel.itexcellence.duckdns.org
# The value below is a placeholder: replace it with your own name. docker compose only checks that the variable
# is set, so it cannot tell that a copied example was left as it is. No app can use this name.
PANEL_DOMAIN=panel.apps.example.com

# RAM available to deployed apps in total, and the most one service may ask for (MB).
MEMORY_BUDGET_MB=5632
MAX_SERVICE_MEMORY_MB=2048

# GitHub App (docs/operations.md, "GitHub App"). Leave GITHUB_APP_ID empty to build public repositories only.
GITHUB_APP_ID=
# Absolute path ON THIS SERVER to the App's private key (.pem), outside this folder, chmod 600. Mounted read-only into the worker only.
GITHUB_APP_PRIVATE_KEY_PATH=
# The App's webhook secret (openssl rand -hex 32). Only the dashboard reads it.
GITHUB_WEBHOOK_SECRET=

# --- Alternative mode: ports 80/443 are already used (for example by Nginx Proxy Manager) ---
# Traefik then listens on one alternate HTTPS port, and a single wildcard certificate (*.<APPS_DOMAIN>)
# comes from a DNS-01 challenge at DuckDNS, so APPS_DOMAIN must be a DuckDNS name (xxx.duckdns.org).
# Apps get https://<service>-<project>.<APPS_DOMAIN>:<TRAEFIK_HTTPS_PORT>. See docs/operations.md.
# The override file also sets TLS_MODE=dns-wildcard and PUBLIC_HTTPS_PORT for the worker; do not set them here.
# Needs Docker Compose 2.24.0 or newer. Uncomment this line to turn it on:
# COMPOSE_FILE=docker-compose.yml:docker-compose.dns-tls.yml
# Optional: the host port for HTTPS (default 8443).
# TRAEFIK_HTTPS_PORT=8443
# The DuckDNS token does NOT go in this file. Put  DUCKDNS_TOKEN=<token>  (from your duckdns.org account
# page) in a file named .duckdns.env next to docker-compose.yml, chmod 600. It is read by Traefik only and
# is never committed.
